# Copy to .env (or ~/.config/briefing/env for the systemd unit) and fill in. Every value below is a placeholder.

# Miniflux: the reader that holds your web feeds and newsletters (read-only; nothing is marked read).
BRIEFING_MINIFLUX_URL=https://miniflux.example.com
BRIEFING_MINIFLUX_TOKEN=replace-with-a-miniflux-api-token

# The editor: the `claude` CLI on PATH, with its own key. An empty model switches the editor off; the edition still builds.
ANTHROPIC_API_KEY=sk-ant-replace-me
BRIEFING_EDITOR_MODEL=opus
# A plain-text description of what you want to read, given to every editor run.
BRIEFING_PROFILE=./interests.md

# Your time zone: names the edition (Morning before 11:00, else Midday) and dates it.
BRIEFING_TZ=Europe/London

# Where editions are written, and (optionally) the address that folder is served at.
BRIEFING_OUTPUT=./editions
BRIEFING_BASE_URL=
# Run state (last run, edition records, what has been shown). Defaults to ~/.local/state/briefing.
BRIEFING_STATE=./state

# Optional: Firecrawl, for Health Affairs Forefront and summary-only feeds. Without it those are skipped.
BRIEFING_FIRECRAWL_API_KEY=

# Optional: Kindle delivery through Resend. Leave BRIEFING_KINDLE_TO empty to switch it off.
BRIEFING_KINDLE_TO=your-name@kindle.example
BRIEFING_KINDLE_FROM=The Briefing <briefing@your-domain.example>
BRIEFING_RESEND_API_KEY=re_replace_me
